rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // নিজের খাতা, অথবা রিকভারি কোড দিয়ে যুক্ত হওয়া খাতা
    function canUse(uid) {
      return signedIn() && (request.auth.uid == uid ||
        exists(/databases/$(database)/documents/users/$(uid)/access/$(request.auth.uid)));
    }

    match /users/{uid}/{document=**} {
      allow read, write: if canUse(uid);
    }

    // নতুন Gmail থেকে আগের খাতায় যুক্ত হওয়া: সঠিক নম্বর+কোডের টোকেন লাগবে
    match /users/{uid}/access/{other} {
      allow create: if signedIn() && request.auth.uid == other
        && request.resource.data.token is string
        && get(/databases/$(database)/documents/recovery/$(request.resource.data.token)).data.uid == uid;
    }

    // রিকভারি টোকেন: শুধু টোকেন জানলে পড়া যায়, তালিকা দেখা যায় না
    match /recovery/{token} {
      allow get: if signedIn();
      allow create: if signedIn() && canUse(request.resource.data.uid);
      allow update: if signedIn() && canUse(resource.data.uid) && canUse(request.resource.data.uid);
      allow delete: if signedIn() && (resource == null || canUse(resource.data.uid));
    }
  }
}
